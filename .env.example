# --- Proveedor LLM (OpenAI por defecto; Anthropic alternativo; Google solo opcional) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5
# Opcional: LLM_PROVIDER=google (requiere pip install langchain-google-genai)
# GOOGLE_API_KEY=...
# GEMINI_MODEL=gemini-flash-latest
# Modelo distinto (más grande) solo para el supervisor; vacío = el mismo de los especialistas
SUPERVISOR_MODEL=
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3

# --- Topología y topes (anti "Supervisor Infinito") ---
MAX_PASOS=6                 # invocaciones de especialistas por consulta (incluye reparaciones)
MAX_REPARACIONES=2          # reintentos con error específico antes de escalar a revisión humana
RECURSION_LIMIT=40          # techo duro de LangGraph; >= 3*MAX_PASOS+4, y la compuerta HITL (M7) suma hasta 4 pasos
ESPECIALISTA_TIMEOUT_S=60

# --- Retriever del Investigador ---
RETRIEVER_BACKEND=local     # local (BM25 propio, sin red) | pinecone (BM25 + Pinecone, requiere requirements-pinecone.txt)
TOP_K=5
PINECONE_API_KEY=
PINECONE_INDEX_NAME=techcorp-rag-hibrido
PINECONE_NAMESPACE=politicas-internas
PINECONE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Validación ---
OPERANDOS_ESTRICTOS=false   # true: un operando sin origen verificable BLOQUEA; false: solo advierte

TRACES_DIR=traces
LOG_LEVEL=INFO

# ============================ Pre-entrega 7: API de producción ============================
# API_KEY vacío = sin autenticación (solo desarrollo). Con valor: header X-API-Key obligatorio.
# (el comentario va en su propia línea: `docker compose` NO lo quita si va después de un valor vacío)
API_KEY=
REDIS_URL=redis://localhost:6379/0
KEY_PREFIX=agentapi         # prefijo de TODAS las claves de Redis de la app
JOB_TTL_S=86400             # los registros de jobs expiran a las 24 h
QUEUE_MAX_LEN=1000          # más pendientes que esto -> POST /tasks responde 429 (contrapresión)
WORKER_CONCURRENCY=5        # jobs simultáneos por proceso worker
WORKER_EMBEDDED=true        # true: el worker corre dentro de la API (desarrollo). Docker: false + servicio worker
JOB_TIMEOUT_S=300           # tope de duración de UN job (si se pasa -> FAILED)
LEASE_TTL_S=30              # latido del worker; sin latido el job se considera huérfano y se reencola
MAX_ATTEMPTS=3              # reintentos de un job huérfano antes de marcarlo FAILED
CHECKPOINTER=redis          # redis (producción, exige Redis 8 / Redis Stack) | memory (solo tests)
CHECKPOINT_TTL_MIN=1440     # expiración de los checkpoints de LangGraph (minutos)
RRHH_DESTINATARIO=rrhh@techcorp.example

# --- Observabilidad: phoenix | langsmith | none ---
OBSERVABILITY=phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME=agente-m7
# LangSmith (si OBSERVABILITY=langsmith):
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agente-m7
